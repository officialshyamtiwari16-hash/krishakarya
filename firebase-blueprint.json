{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in Krishakarya",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "maxLength": 120 },
        "username": { "type": "string", "maxLength": 25 },
        "village": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "avatar": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "isSahyogi": { "type": "boolean" },
        "isMachineryOwner": { "type": "boolean" }
      },
      "required": ["id", "name", "phone"]
    },
    "UsernameRegistry": {
      "title": "UsernameRegistry",
      "description": "Unique username registry mapping handle to userId",
      "type": "object",
      "properties": {
        "handle": { "type": "string", "maxLength": 25 },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "claimedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["handle", "userId"]
    },
    "Sahyogi": {
      "title": "Sahyogi",
      "description": "Sahyogi agricultural labor helper listing",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "village": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "dailyRate": { "type": "number" },
        "hourlyRate": { "type": "number" },
        "skills": { "type": "array" },
        "experienceYears": { "type": "number" },
        "availabilityStatus": { "type": "string", "enum": ["available", "busy"] },
        "bio": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "userId", "name", "phone", "dailyRate"]
    },
    "Machinery": {
      "title": "Machinery",
      "description": "Agricultural equipment listing for rent, buy, or sell",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "maxLength": 100 },
        "ownerPhone": { "type": "string", "maxLength": 20 },
        "title": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 80 },
        "listingType": { "type": "string", "enum": ["rent", "sale", "both"] },
        "condition": { "type": "string", "enum": ["Brand New", "Certified Used", "Good Working Condition", "Well Maintained"] },
        "ratePerDay": { "type": "number" },
        "ratePerHour": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "brandModel": { "type": "string", "maxLength": 100 },
        "horsepower": { "type": "number" },
        "yearOfMfg": { "type": "number" },
        "village": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "availabilityStatus": { "type": "string", "enum": ["available", "rented", "sold"] }
      },
      "required": ["id", "ownerId", "title", "category"]
    },
    "MarketplaceListing": {
      "title": "MarketplaceListing",
      "description": "Produce and commodities listing for crops, vegetables, fruits, eggs, fish, dairy, etc.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sellerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sellerName": { "type": "string", "maxLength": 100 },
        "sellerPhone": { "type": "string", "maxLength": 20 },
        "title": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 80 },
        "variety": { "type": "string", "maxLength": 100 },
        "pricePerUnit": { "type": "number" },
        "unit": { "type": "string", "maxLength": 30 },
        "quantityAvailable": { "type": "number" },
        "minOrderQuantity": { "type": "number" },
        "isNegotiable": { "type": "boolean" },
        "isOrganic": { "type": "boolean" },
        "harvestDate": { "type": "string", "maxLength": 50 },
        "village": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "image": { "type": "string" },
        "description": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["available", "sold", "reserved"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "sellerId", "sellerName", "sellerPhone", "title", "category", "pricePerUnit", "unit", "quantityAvailable", "district"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Service booking record between farmer and provider",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["sahyogi", "machinery"] },
        "itemId": { "type": "string", "maxLength": 128 },
        "itemName": { "type": "string", "maxLength": 150 },
        "renterId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "renterName": { "type": "string", "maxLength": 100 },
        "renterPhone": { "type": "string", "maxLength": 20 },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "maxLength": 100 },
        "ownerPhone": { "type": "string", "maxLength": 20 },
        "startDate": { "type": "string", "maxLength": 30 },
        "endDate": { "type": "string", "maxLength": 30 },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Declined", "Completed", "Cancelled"] },
        "declineReason": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "type", "itemId", "renterId", "totalAmount", "status"]
    },
    "LedgerEntry": {
      "title": "LedgerEntry",
      "description": "Kisan digital khatabook ledger record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "maxLength": 30 },
        "title": { "type": "string", "maxLength": 150 },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "category": { "type": "string", "maxLength": 50 },
        "amount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "userId", "date", "type", "amount"]
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Firestore connectivity health check document",
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/test/{testId}": {
      "schema": { "$ref": "#/entities/TestConnection" },
      "description": "Firestore connection validation health check path"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection"
    },
    "/usernames/{usernameId}": {
      "schema": { "$ref": "#/entities/UsernameRegistry" },
      "description": "Unique handle registry"
    },
    "/sahyogis/{sahyogiId}": {
      "schema": { "$ref": "#/entities/Sahyogi" },
      "description": "Sahyogi labor helper listings"
    },
    "/machineries/{machineryId}": {
      "schema": { "$ref": "#/entities/Machinery" },
      "description": "Machinery and equipment listings"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Protected booking transactions between farmers and providers"
    },
    "/ledger_entries/{entryId}": {
      "schema": { "$ref": "#/entities/LedgerEntry" },
      "description": "Private financial records for farmer's Kisan Khatabook"
    },
    "/marketplace_listings/{listingId}": {
      "schema": { "$ref": "#/entities/MarketplaceListing" },
      "description": "Public produce and commodities marketplace listings"
    }
  }
}
