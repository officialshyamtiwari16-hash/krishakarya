rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Connection test document
    match /test/{testId} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Unique Username Registry
    match /usernames/{usernameId} {
      allow read, write: if true;
    }

    // Sahyogi Labor Listings
    match /sahyogis/{sahyogiId} {
      allow read, write: if true;
    }

    // Machinery Equipment Listings
    match /machineries/{machineryId} {
      allow read, write: if true;
    }

    // Booking Records
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Ledger Khatabook Entries
    match /ledger_entries/{entryId} {
      allow read, write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

